NODE_ENV=development
PORT=3001

DB_HOST=localhost
# URL de teselas administrado por la institución; vacío desactiva el mapa vial.
# La plantilla debe usar {z}, {x} e {y}; no usar proveedores públicos para ubicaciones operativas.
SIGBO_MAP_TILES_URL=
SIGBO_MAP_ATTRIBUTION=
# Déjelo vacío para una instancia por puerto; use el nombre (p. ej. SQLEXPRESS)
# para una instancia SQL Server nombrada con TCP/IP habilitado.
DB_INSTANCE=
DB_PORT=1433
DB_NAME=sigbo_cbvc
DB_USER=sigbo_app
DB_PASSWORD=change_me
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# En produccion ambos valores se validan al iniciar:
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false

# Genere secretos distintos para cada entorno; por ejemplo en PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Nunca copie los marcadores de esta plantilla a un entorno ejecutable.
JWT_SECRET=
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRATION=7d

# La interfaz web usa cookies HttpOnly para access y refresh tokens.
# Solo para desarrollo local HTTP. En producción el backend fuerza Secure=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=.ejemplo.org

# Orígenes autorizados, separados por coma. No usar * con sesiones por cookie.
CORS_ORIGIN=http://localhost:3000
# En red local / tunel para la app movil (.movile), agregar el origen que
# corresponda SIN tocar codigo, p. ej.:
# CORS_ORIGIN=http://localhost:3000,http://192-168-1-10:3000
# (la app nativa usa Authorization: Bearer y no depende de CORS).
# Ventana anti-rebote de alertas moviles (segundos): si el mismo bombero
# pide el mismo tipo con otra alerta PENDIENTE dentro de la ventana, se
# devuelve la vigente en lugar de duplicar. Parametrizado, no en codigo.
ALERTAS_DEBOUNCE_SEGUNDOS=10
# Swagger está deshabilitado por omisión. Habilitarlo sólo en un entorno
# controlado y con acceso de red restringido.
SWAGGER_ENABLED=false

# El comando npm run seed crea cuentas de demostración fuera de producción.
# En producción está bloqueado; no lo habilite salvo inicialización institucional
# aprobada, y nunca crea usuarios de demostración allí.
# Definir esta clave solo en el entorno local antes de ejecutar npm run seed.
# No se conserva una contrasena de demostracion en el repositorio.
SIGBO_DEMO_PASSWORD=
# SIGBO_ALLOW_PRODUCTION_SEED=false

# Avisos opcionales por Telegram (API de bots, gratuita). Sin estos dos valores no se envia nada.
# 1) En Telegram, hable con @BotFather y cree un bot: le da el token.
# 2) Agregue el bot a un grupo o canal y obtenga el chat_id (https://api.telegram.org/bot<TOKEN>/getUpdates).
# El aviso es solo informativo; las respuestas siguen entrando por la app.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Sesion: "Mantener sesion iniciada" (app y web que lo envien). Sin elegir rige REFRESH_TOKEN_EXPIRATION.
# SESION_MANTENIDA_DIAS=30        dias que se renuevan con el uso (1-90)
# SESION_MANTENIDA_MAX_DIAS=90    tope absoluto desde el inicio de sesion (hasta 365)
# SESION_CORTA_HORAS=12           duracion si la persona NO mantiene la sesion (1-24)
# Despacho: horas que dura el "Al llamado" temporal de quien se suma a una busqueda de personal adicional.
# DESPACHO_TEMPORAL_HORAS=4
# IA: carpeta donde debe estar el binario de Piper (piper.exe) y sus voces .onnx. Sin esto, la web no acepta rutas nuevas.
# IA_PIPER_DIR=C:/Herramientas/piper

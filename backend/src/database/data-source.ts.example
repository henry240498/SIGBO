/**
 * Plantilla opcional para herramientas de TypeORM que requieran un DataSource
 * explícito (por ejemplo, una inspección local). El backend ya está conectado
 * mediante `src/core/database/data-source-options.ts` y `AppModule`; no hay
 * que instalar dependencias ni modificar el módulo raíz.
 *
 * Para usarla, cópiela como `src/database/data-source.ts`. No active
 * `synchronize`: el esquema de SIGBO lo administran las migraciones SQL.
 */
import { DataSource } from 'typeorm';
import { dataSourceOptions } from '../core/database/data-source-options';

export const AppDataSource = new DataSource(dataSourceOptions);
export default AppDataSource;

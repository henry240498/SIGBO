anos.","archivos":["backend/src/shared/entities/parametro.entity.ts"],"terminos":["parametro","parametros","organizacion","tipo","pais","departamento","ciudad","barrio","profesion","idioma","nivel","grupo","sanguineo","factor","seguro","aseguradora","evento","asistencia","ubicacion","equipo","estado","presencia","guardia","sector","estacion"],"curado":false,"tabla":"organizacion.parametros"},{"id":"entity--participante-evento","tipo":"ENTITY","nombre":"ParticipanteEvento","dominio":"asistencia","nivel":"L1","resumen":"Asistencia de una persona (bombero o externo) A un evento -- distinta de la marcacion fisica de entrada/salida del cuartel. Exactamente uno de `bomberoId`/`participanteExternoId` debe estar presente (misma logica que academia.inscripciones_cursos). `estadoParticipacion` nunca se asume AUSENTE_CONFIRMADO automaticamente por falta de marcacion: solo se llega a ese estado por confirmacion explicita de un responsable.","archivos":["backend/src/shared/entities/participante-evento.entity.ts"],"terminos":["participante","evento","participantes","operaciones","estado","participacion","completa","parcial","registrada","ausente","confirmado"],"curado":false,"tabla":"operaciones.participantes_evento"},{"id":"entity--participante-externo","tipo":"ENTITY","nombre":"ParticipanteExterno","dominio":"asistencia","nivel":"L1","resumen":"Persona que participa de un evento sin pertenecer al cuerpo de bomberos (civiles, estudiantes, invitados, personal de otras instituciones, etc.). Nunca genera automaticamente un registro en personal.bomberos.","archivos":["backend/src/shared/entities/participante-externo.entity.ts"],"terminos":["participante","externo","participantes","externos","operaciones"],"curado":false,"tabla":"operaciones.participantes_externos"},{"id":"entity--permiso","tipo":"ENTITY","nombre":"Permiso","dominio":"seguridad","nivel":"L1","resumen":"Entidad Permiso, persistida en seguridad.permisos.","archivos":["backend/src/shared/entities/permiso.entity.ts"],"te
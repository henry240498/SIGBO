{
  "tipo": "registro_de_diseno_no_api_implementada",
  "version_contrato": 1,
  "fecha": "2026-10-08",
  "prefijo": "/api/v1",
  "capacidades": {
    "C": {
      "nombre": "Consulta",
      "requisito": "`matpel:consultar`, sesión vigente; versión validada accesible",
      "uso": "Catálogo y fuente GRE; no acceso a incidentes ajenos"
    },
    "V": {
      "nombre": "Ver incidente",
      "requisito": "C **y** acceso al Servicio concedido por el núcleo/Pantallas, con redacción de datos sensibles",
      "uso": "Panel/contexto y decisiones autorizadas"
    },
    "R": {
      "nombre": "Registrar",
      "requisito": "V **y** `servicios:operar`, capacidad vigente para registrar en ese Servicio; estado permite la acción",
      "uso": "Identificación, parámetros y evaluaciones; sin convertir registro en decisión de mando"
    },
    "D": {
      "nombre": "Decidir",
      "requisito": "V **y** `servicios:comandar`, autoridad de mando/delegación acreditada por el núcleo para acción y hora del hecho",
      "uso": "Registrar/rectificar decisión o cambiar edición; un administrador técnico no obtiene mando por administrar GRE"
    },
    "A": {
      "nombre": "Administrar",
      "requisito": "`matpel:administrar_gre`, sesión vigente",
      "uso": "Seleccionar documento, solicitar importación, revisar reporte/comparación; no activar solo con este permiso"
    },
    "S": {
      "nombre": "Validar contenido",
      "requisito": "`matpel:validar_gre`, versión candidata y alcance de revisión",
      "uso": "Registrar revisión humana con fundamento. La misma persona puede tener A/S si institución lo autoriza; no imponer doble aprobación inventada"
    },
    "P": {
      "nombre": "Activar",
      "requisito": "`matpel:activar_gre`, versión VALIDADA, controles críticos satisfechos y revisión esperada del puntero",
      "uso": "Activación/recuperación auditada; no valida ni corrige contenido por sí sola"
    },
    "F": {
      "nombre": "OCR/evidencia",
      "requisito": "R **y** `adjuntos:subir`, autorización al adjunto/Servicio y tipo permitido",
      "uso": "Captura y reconocimiento; lectura exige también autorización al adjunto y `adjuntos:ver`"
    },
    "E": {
      "nombre": "Leer evidencia",
      "requisito": "V **y** `adjuntos:ver`, evidencia/reconocimiento pertenecientes al Servicio y alcance vigente",
      "uso": "Consultar foto/candidatos/historial autorizado, sin conceder subir o modificar"
    },
    "G": {
      "nombre": "Posiciones",
      "requisito": "V **y** permiso GPS/mapa y confidencialidad existentes para la información concreta",
      "uso": "Posiciones de personas/móviles. Leer geometría GRE no concede G"
    }
  },
  "permisos_nuevos_propuestos": [
    "matpel:consultar",
    "matpel:administrar_gre",
    "matpel:validar_gre",
    "matpel:activar_gre"
